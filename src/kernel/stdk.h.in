#ifndef STDK_H
#define STDK_H
#include <stddef.h>
#include <stdint.h>
#ifdef __cplusplus
extern "C" {
#endif
@STDK_STATUS@
typedef struct stdk_id {
	uint64_t low;
	uint64_t high;
} stdk_id;
typedef struct stdk_node stdk_node;
typedef struct stdk_call_envelope stdk_call_envelope;
typedef uint32_t (*stdk_callback)(stdk_call_envelope *call);
struct stdk_node {
	uint32_t structure_size;
	uint32_t flags;
	stdk_id id;
	uint64_t value_low;
	uint64_t value_high;
	uint8_t *bytes;
	uint64_t byte_capacity;
	uint64_t byte_length;
	stdk_node *child;
	stdk_node *next;
	uint64_t reserved[2];
};
struct stdk_call_envelope {
	uint32_t structure_size;
	uint32_t flags;
	stdk_id operation;
	stdk_node *request;
	stdk_node *response;
	stdk_node *diagnostic;
	uint8_t *workspace;
	uint64_t workspace_capacity;
	stdk_callback callback;
	void *callback_context;
	uint64_t reserved[4];
};
@STDK_LAYOUT@
#ifdef __cplusplus
#define STDK_STATIC_ASSERT(condition, message) static_assert(condition, message)
#else
#define STDK_STATIC_ASSERT(condition, message) _Static_assert(condition, message)
#endif
@STDK_ASSERT@
@STDK_CALL@

/* Session boundary over caller-owned storage with opaque handles and no
 * allocator, so hosts keep control of every byte. Storage sizing lives in
 * stdk_session_storage because driver state is fixed per pair; the storage
 * must be aligned to 8 bytes and remain alive for the session's lifetime.
 * The step pump reports consumed and produced counts separately so callers
 * can stream across buffer boundaries, but each step accepts at most
 * 131064 input bytes (the 128 KiB pending window minus its framing slack);
 * larger inputs must be split across steps. Input and output ranges must not
 * overlap each other or the session storage.
 *
 * stdk_session_create applies generous default ceilings (16 GiB encoded,
 * 16 GiB decoded, 4 GiB work, 1 Mi entries) so zip-bomb limits hold engine-
 * side by default; pass explicit ceilings through stdk_session_bounded, or
 * std.math.maxInt values to opt back into unbounded streaming.
 *
 * A failed create poisons the storage: every later step returns
 * invalid_call and stdk_session_destroy reports ok. A failed step fails the
 * session permanently; later steps return invalid_call instead of depending
 * on driver-specific recovery. Destroy is idempotent and total: live
 * sessions are destroyed, dead sessions report ok, and storage that was
 * never successfully created is refused rather than dispatched through
 * garbage. stdk_session_failure reads back the failing status and detail.
 * stdk_session_catalog carries the versioned pair list so hosts discover
 * streamable codecs without hardcoding them.
 */
uint64_t stdk_session_storage(const char *component, const char *verb);
uint32_t stdk_session_create(const char *component, const char *verb,
			     void *storage, uint64_t storage_len);
uint32_t stdk_session_bounded(const char *component, const char *verb,
			      void *storage, uint64_t storage_len,
			      uint64_t max_encoded, uint64_t max_decoded,
			      uint64_t max_work, uint64_t max_entries);
uint32_t stdk_session_step(void *session, const uint8_t *input,
			   uint64_t input_len, uint8_t *output,
			   uint64_t output_len, int end_of_input,
			   uint64_t counts_out[2], int *state_out);
uint32_t stdk_session_failure(void *session, uint32_t *status_out,
			      uint64_t *detail_out);
const char *stdk_session_catalog(void);
uint32_t stdk_session_destroy(void *session);
#ifdef __cplusplus
}
#endif
#endif
