#ifndef STDK_H
#define STDK_H
#include <stddef.h>
#include <stdint.h>
#ifdef __cplusplus
extern "C" {
#endif
@STDK_STATUS@
// The library forces 8-byte alignment for these words;
// the header states it so 32-bit consumers see one layout.
#if defined(__cplusplus)
#define STDK_ALIGNAS alignas
#else
#define STDK_ALIGNAS _Alignas
#endif
typedef struct stdk_id {
	STDK_ALIGNAS(8) uint64_t low;
	STDK_ALIGNAS(8) uint64_t high;
} stdk_id;
typedef struct stdk_node stdk_node;
typedef struct stdk_call_envelope stdk_call_envelope;
typedef uint32_t (*stdk_callback)(stdk_call_envelope *call);
struct stdk_node {
	uint32_t structure_size;
	uint32_t flags;
	stdk_id id;
	uint64_t value_low;
	uint64_t value_high;
	uint8_t *bytes;
	uint64_t byte_capacity;
	uint64_t byte_length;
	stdk_node *child;
	stdk_node *next;
	uint64_t reserved[2];
};
struct stdk_call_envelope {
	uint32_t structure_size;
	uint32_t flags;
	stdk_id operation;
	stdk_node *request;
	stdk_node *response;
	stdk_node *diagnostic;
	uint8_t *workspace;
	uint64_t workspace_capacity;
	stdk_callback callback;
	void *callback_context;
	uint64_t reserved[4];
};
@STDK_LAYOUT@
#ifdef __cplusplus
#define STDK_STATIC_ASSERT(condition, message) static_assert(condition, message)
#else
#define STDK_STATIC_ASSERT(condition, message) _Static_assert(condition, message)
#endif
@STDK_ASSERT@
@STDK_CALL@

/* Asynchronous submission, symmetric to stdk_call: submit keeps control.
 * The completion record is caller-owned storage; the ticket is its pointer.
 * With the inline executor the call completes before stdk_submit returns.
 * A malformed envelope surfaces as an invalid_call record status.
 * stdk_poll is idempotent and non-blocking; cancel is idempotent like poll.
 * A pending cancel plants a request the task honors at its start boundary.
 * A running envelope always completes; the record then reports cancelled.
 * stdk_group takes caller-owned submission descriptors plus an executor.
 * A null executor selects the inline default.
 * The executor vtable is C-shaped: run schedules task.invoke(context)
 * exactly once, on any thread; the task flips the completion record.
 */
#define STDK_COMPLETION_IN_PROGRESS UINT32_C(0)
#define STDK_COMPLETION_DONE UINT32_C(1)
#define STDK_COMPLETION_PENDING UINT32_C(4294967295)
struct stdk_completion {
	uint32_t structure_size;
	uint32_t state;
	uint32_t status;
	uint32_t reserved;
};
STDK_STATIC_ASSERT(sizeof(struct stdk_completion) == 16,
		   "stdk_completion size mismatch: the ABI fixes 16 bytes");
struct stdk_submission {
	stdk_call_envelope *call;
	struct stdk_completion *completion;
};
struct stdk_task {
	void *context;
	uint32_t (*invoke)(void *context);
};
struct stdk_executor_vtable {
	uint32_t (*run)(void *ptr, struct stdk_task task);
};
struct stdk_executor {
	void *ptr;
	const struct stdk_executor_vtable *vtable;
};
uint32_t stdk_submit(stdk_call_envelope *call, struct stdk_completion *completion);
uint32_t stdk_group(struct stdk_submission *submissions, uint64_t count,
		    const struct stdk_executor *executor);
uint32_t stdk_poll(struct stdk_completion *completion);
uint32_t stdk_cancel(struct stdk_completion *completion);

/* Session boundary over caller-owned storage with opaque handles and no
 * allocator, so hosts keep control of every byte. Storage sizing lives in
 * stdk_session_storage because driver state is fixed per pair; the storage
 * must be aligned to 8 bytes and remain alive for the session's lifetime.
 * The step pump reports consumed and produced counts separately so callers
 * can stream across buffer boundaries. Each step accepts at most 131064
 * input bytes (the 128 KiB window minus framing slack); larger inputs split
 * across steps. Input and output ranges must not
 * overlap each other or the session storage.
 *
 * stdk_session_create applies generous default ceilings (16 GiB encoded,
 * 16 GiB decoded, 4 GiB work, 1 Mi entries). Zip-bomb limits hold engine-
 * side by default; pass explicit ceilings through stdk_session_bounded, or
 * UINT64_MAX to opt back into unbounded streaming.
 *
 * A failed create poisons the storage: every later step returns
 * invalid_call and stdk_session_destroy reports ok. A failed step fails the
 * session permanently; later steps return invalid_call instead of depending
 * on driver-specific recovery. Destroy is idempotent and total: live
 * sessions are destroyed, dead sessions report ok. Storage that was never
 * successfully created is refused rather than dispatched through
 * garbage. stdk_session_failure reads back the failing status and detail.
 * stdk_session_catalog carries the versioned pair list so hosts discover
 * streamable codecs without hardcoding them.
 */
uint64_t stdk_session_storage(const char *component, const char *verb);
uint32_t stdk_session_create(const char *component, const char *verb,
			     void *storage, uint64_t storage_len);
uint32_t stdk_session_bounded(const char *component, const char *verb,
			      void *storage, uint64_t storage_len,
			      uint64_t max_encoded, uint64_t max_decoded,
			      uint64_t max_work, uint64_t max_entries);
uint32_t stdk_session_step(void *session, const uint8_t *input,
			   uint64_t input_len, uint8_t *output,
			   uint64_t output_len, int end_of_input,
			   uint64_t counts_out[2], int *state_out);
uint32_t stdk_session_failure(void *session, uint32_t *status_out,
			      uint64_t *detail_out);
const char *stdk_session_catalog(void);
uint32_t stdk_session_destroy(void *session);
#ifdef __cplusplus
}
#endif
#endif
