.{
    .id = .{ .low = "0x6e6b82f08d910405", .high = "0xa7a351053d6d4005" },
    .name = "tar",
    .class = "grammar",
    .verbs = .{ "inspect", "decode_ordinal", "encode_ordinal" },
    .parameters = .{
        .{ .name = "ordinal", .family = 2, .ordinal = 1, .representation = "scalar_words" },
        .{ .name = "entry_count", .family = 2, .ordinal = 2, .representation = "scalar_words" },
        .{ .name = "entry_name", .family = 2, .ordinal = 3, .representation = "bytes" },
        .{ .name = "entry_size", .family = 2, .ordinal = 4, .representation = "scalar_words" },
        .{ .name = "entry", .family = 2, .ordinal = 5, .representation = "node_chain" },
        .{ .name = "entry_data", .family = 2, .ordinal = 6, .representation = "bytes" },
        .{ .name = "entry_method", .family = 2, .ordinal = 7, .representation = "scalar_words" },
        .{ .name = "comment", .family = 2, .ordinal = 8, .representation = "bytes" },
        .{ .name = "entry_typeflag", .family = 2, .ordinal = 9, .representation = "scalar_words" },
        .{ .name = "entry_link_name", .family = 2, .ordinal = 10, .representation = "bytes" },
        .{ .name = "entry_uid", .family = 2, .ordinal = 11, .representation = "scalar_words" },
        .{ .name = "entry_mtime", .family = 2, .ordinal = 12, .representation = "scalar_words" },
        .{ .name = "entry_filter", .family = 2, .ordinal = 13, .representation = "scalar_words" },
        // A split set arrives as repeated bytes parameters in volume order;
        // the source stays the first part, and these carry the tail.
        .{ .name = "archive_volumes", .family = 2, .ordinal = 14, .representation = "bytes" },
        // A split write carries the volume granularity; the set leaves as
        // one sink stream cut at the produced volume boundaries.
        .{ .name = "archive_volume_size", .family = 2, .ordinal = 15, .representation = "scalar_words" },
    },
    .capabilities = .{ "read", "write", "size", "replay" },
    // GNU multi-volume sets: members cut at the volume boundary continue
    // under 'M' headers; reads walk the chain and reassemble the member.
    .volumes = .{ "read", "write" },
    .sizing = "metadata_exact",
    .commit = "tentative",
    .limits = .{ .window = 0, .block = 0, .history = 0 },
    .benchmark = .{
        .row = "tar",
        .params = "store",
        .kind = "tar",
        .ext = "tar",
        .cmd = "tar",
        .archive = true,
        .ref_params = "store",
        .tunings = .{
            .{},
        },
    },
}
