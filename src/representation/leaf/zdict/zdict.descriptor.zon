.{
    .id = .{ .low = "0x6e6b82f08d910417", .high = "0xa7a351053d6d4017" },
    .name = "zdict",
    .class = "slice",
    .verbs = .{ "required_size", "decoded_size", "encoded_size_bound", "encode", "decode" },
    .parameters = .{
        // A write (or query) trains a dictionary: the source splits into equal sample_size chunks, at most 2^20 samples.
        .{ .name = "sample_size", .family = 13, .ordinal = 2, .representation = "scalar_words" },
        // Optional cap on the trained dictionary in bytes; absence caps it
        // at the corpus size plus the dictionary header.
        .{ .name = "dictionary_size", .family = 13, .ordinal = 3, .representation = "scalar_words" },
    },
    .capabilities = .{ "read", "replay" },
    .sizing = "measured",
    .commit = "tentative",
    .limits = .{ .window = 0, .block = 0, .history = 0 },
}
